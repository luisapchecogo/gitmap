{
  "name": "gitmap",
  "displayName": "GitMap",
  "description": "Compare any two commits and review every changed file, folder by folder, in an explorer-style view.",
  "version": "0.0.1",
  "publisher": "luispacheco",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisapchecogo/gitmap.git"
  },
  "bugs": {
    "url": "https://github.com/luisapchecogo/gitmap/issues"
  },
  "homepage": "https://github.com/luisapchecogo/gitmap#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "compare",
    "diff",
    "commits",
    "review"
  ],
  "activationEvents": [
    "onFileSystem:gitmap"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitMap runs git, which can execute commands from a repository's configuration, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GitMap runs the git command line, which needs files on disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmap",
          "title": "GitMap",
          "icon": "media/gitmap.svg"
        }
      ]
    },
    "views": {
      "gitmap": [
        {
          "id": "gitmap.compare",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitmap.compare",
        "contents": "Pick two revisions to see every file that changed between them.\n[Compare Revisions…](command:gitmap.compareRevisions)",
        "when": "gitmap.hasRepository && !gitmap.hasComparison"
      },
      {
        "view": "gitmap.compare",
        "contents": "No git repository was found in this workspace. Open a folder that contains a git repository to compare its commits.",
        "when": "!gitmap.hasRepository"
      }
    ],
    "commands": [
      {
        "command": "gitmap.compareRevisions",
        "title": "Compare Revisions…",
        "category": "GitMap",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitmap.swapCompare",
        "title": "Swap Base and Target",
        "category": "GitMap",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitmap.toggleCompareMode",
        "title": "Toggle PR-Style Comparison (From Merge Base)",
        "category": "GitMap",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitmap.clearCompare",
        "title": "Clear Comparison",
        "category": "GitMap",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitmap.openAllChanges",
        "title": "Open All Changes",
        "category": "GitMap",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitmap.openChange",
        "title": "Open Changes",
        "category": "GitMap",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitmap.openFile",
        "title": "Open File",
        "category": "GitMap",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitmap.copyPath",
        "title": "Copy Relative Path",
        "category": "GitMap"
      },
      {
        "command": "gitmap.showMoreFiles",
        "title": "Show More Changed Files",
        "category": "GitMap"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitmap.compareRevisions",
          "when": "view == gitmap.compare",
          "group": "navigation@1"
        },
        {
          "command": "gitmap.swapCompare",
          "when": "view == gitmap.compare && gitmap.hasComparison",
          "group": "navigation@2"
        },
        {
          "command": "gitmap.openAllChanges",
          "when": "view == gitmap.compare && gitmap.hasChanges",
          "group": "navigation@3"
        },
        {
          "command": "gitmap.toggleCompareMode",
          "when": "view == gitmap.compare",
          "group": "1_mode@1"
        },
        {
          "command": "gitmap.clearCompare",
          "when": "view == gitmap.compare && gitmap.hasComparison",
          "group": "2_clear@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitmap.openFile",
          "when": "view == gitmap.compare && viewItem == file",
          "group": "inline"
        },
        {
          "command": "gitmap.openChange",
          "when": "view == gitmap.compare && viewItem == file",
          "group": "1_open@1"
        },
        {
          "command": "gitmap.openFile",
          "when": "view == gitmap.compare && viewItem == file",
          "group": "1_open@2"
        },
        {
          "command": "gitmap.copyPath",
          "when": "view == gitmap.compare && viewItem =~ /^(file|folder)$/",
          "group": "2_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitmap.openChange",
          "when": "false"
        },
        {
          "command": "gitmap.openFile",
          "when": "false"
        },
        {
          "command": "gitmap.copyPath",
          "when": "false"
        },
        {
          "command": "gitmap.showMoreFiles",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "gitmap.addedResourceForeground",
        "description": "Color of added files in the GitMap Changes view.",
        "defaults": {
          "dark": "gitDecoration.addedResourceForeground",
          "light": "gitDecoration.addedResourceForeground",
          "highContrast": "gitDecoration.addedResourceForeground",
          "highContrastLight": "gitDecoration.addedResourceForeground"
        }
      },
      {
        "id": "gitmap.modifiedResourceForeground",
        "description": "Color of modified files in the GitMap Changes view.",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "gitmap.deletedResourceForeground",
        "description": "Color of deleted files in the GitMap Changes view.",
        "defaults": {
          "dark": "gitDecoration.deletedResourceForeground",
          "light": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground",
          "highContrastLight": "gitDecoration.deletedResourceForeground"
        }
      },
      {
        "id": "gitmap.renamedResourceForeground",
        "description": "Color of renamed files in the GitMap Changes view.",
        "defaults": {
          "dark": "gitDecoration.renamedResourceForeground",
          "light": "gitDecoration.renamedResourceForeground",
          "highContrast": "gitDecoration.renamedResourceForeground",
          "highContrastLight": "gitDecoration.renamedResourceForeground"
        }
      },
      {
        "id": "gitmap.untrackedResourceForeground",
        "description": "Color of untracked files in the GitMap Changes view.",
        "defaults": {
          "dark": "gitDecoration.untrackedResourceForeground",
          "light": "gitDecoration.untrackedResourceForeground",
          "highContrast": "gitDecoration.untrackedResourceForeground",
          "highContrastLight": "gitDecoration.untrackedResourceForeground"
        }
      }
    ],
    "configuration": {
      "title": "GitMap",
      "properties": {
        "gitmap.compare.maxFiles": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "markdownDescription": "How many changed files the Changes view shows at a time. Larger comparisons show a **Show more…** item that loads the next batch."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "vsix": "vsce package --no-dependencies",
    "secrets": "node scripts/secret-scan.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "npm-run-all2": "^9.0.3",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
