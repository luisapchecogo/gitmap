{
  "name": "gitmap",
  "displayName": "GitMap",
  "description": "Compare any two commits and review every changed file, folder by folder, in an explorer-style view.",
  "version": "0.0.1",
  "publisher": "luispacheco",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisapchecogo/gitmap.git"
  },
  "bugs": {
    "url": "https://github.com/luisapchecogo/gitmap/issues"
  },
  "homepage": "https://github.com/luisapchecogo/gitmap#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "compare",
    "diff",
    "commits",
    "review"
  ],
  "activationEvents": [
    "onFileSystem:gitmap"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitMap runs git, which can execute commands from a repository's configuration, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GitMap runs the git command line, which needs files on disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmap",
          "title": "GitMap",
          "icon": "media/gitmap.svg"
        }
      ]
    },
    "views": {
      "gitmap": [
        {
          "id": "gitmap.compare",
          "name": "Compare"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitmap.compare",
        "contents": "GitMap is installed and running.\nCommit comparison is not implemented yet."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "vsix": "vsce package --no-dependencies",
    "secrets": "node scripts/secret-scan.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "npm-run-all2": "^9.0.3",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
